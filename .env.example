# Suzerain — variables d'environnement
#
# Convention : copier ce fichier en .env.local et remplir les valeurs.
# Ne jamais committer .env.local — il est ignoré par git.
#
# En pratique, on ne remplit pas ce fichier à la main : on installe
# l'intégration sur vercel.com puis on synchronise avec :
#   pnpm dlx vercel link
#   pnpm dlx vercel env pull .env.local

# v0.2 — persistance Supabase (Vercel Marketplace)
# Provisionnées automatiquement par l'intégration Vercel ↔ Supabase.
# Côté serveur uniquement (Server Actions) : on utilise la service role
# qui bypass la RLS. Ne JAMAIS exposer SUPABASE_SERVICE_ROLE_KEY au client.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Copies publiques (préfixe NEXT_PUBLIC_) injectées par l'intégration —
# inutilisées tant qu'on n'a pas de client browser direct.
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
