# Suzerain — variables d'environnement
#
# Convention : copier ce fichier en .env.local et remplir les valeurs.
# Ne jamais committer .env.local — il est ignoré par git.
#
# En pratique, on ne remplit pas ce fichier à la main : on installe
# l'intégration sur vercel.com puis on synchronise avec :
#   pnpm dlx vercel link
#   pnpm dlx vercel env pull .env.local

# v0.2 — persistance Upstash Redis (Vercel Marketplace)
# Provisionnées automatiquement par l'intégration. Les deux préfixes
# sont supportés par lib/kv.ts.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

